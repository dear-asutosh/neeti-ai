rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allows reading/writing the user's root document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allows reading/writing any subcollection under the user document
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

  }
}
